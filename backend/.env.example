# --- Required ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=1440

# --- OpenAI -----------------------------------------------------------------
# Required to run `python -m app.seed` (builds place embeddings).
# At runtime, absence degrades chat to form-based intake and retrieval to SQL scoring.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- OpenRouteService (optional) --------------------------------------------
# Absence falls back to haversine estimates, rendered as dashed "~35 min" segments.
ORS_API_KEY=

# --- Web search (optional) --------------------------------------------------
# Live one-off events only. Absence falls back to seeded data, silently.
WEB_SEARCH_API_KEY=

# --- LangSmith tracing (optional) -------------------------------------------
# With no API key, all tracing decorators are transparent no-ops.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rihla-itinerary-planner
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Misc -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
